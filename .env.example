NODE_ENV=development
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
AUTH_PORT=4000
AUTH_HOST=127.0.0.1
ENGINE_PORT=8000
WEB_PORT=5173
DATABASE_URL=postgres://privacylint:privacylint@localhost:5432/privacylint
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-local-env

# Generate independent random values for local use. Never commit .env.
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters
OTP_HMAC_SECRET=replace-with-a-different-random-value-at-least-32-characters
CSRF_SECRET=replace-with-another-random-value-at-least-32-characters
ADMIN_BOOTSTRAP_EMAIL=

# Local development mail is served by MailHog (http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PrivacyLint <no-reply@privacylint.local>
# Optional: set AUTH_OTP_MODE=email to require codes (use MailHog or real SMTP).
# Local npm dev skips email OTP if no SMTP credentials are configured.
AUTH_OTP_MODE=

# Optional integrations. Secrets are read by the services, never by Vite.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_OAUTH_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

